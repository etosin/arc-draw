{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"esModuleInterop": true,
		"strict": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"outDir": "build",
		"rootDir": ".",
		"types": ["jest", "node"]
	},
	"include": ["tests/**/*.ts"]
}
